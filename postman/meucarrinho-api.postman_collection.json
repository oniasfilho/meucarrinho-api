            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"2 manga 3,50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send it twice: the second response is replayed (header Idempotent-Replayed: true) and no second item is created. If-Match is pinned per key, so the retry is the identical request. For a fresh demo, change {{idempotencyKey}}."
          },
