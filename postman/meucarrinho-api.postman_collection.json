              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = pm.collectionVariables.get('idempotencyKey');",
                  "if (pm.collectionVariables.get('retryEtagKey') !== key) {",
                  "    pm.collectionVariables.set('retryEtag', pm.collectionVariables.get('etag'));",
                  "    pm.collectionVariables.set('retryEtagKey', key);",
